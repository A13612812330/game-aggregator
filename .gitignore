# ============================================================
# GameHub (game-aggregator) — 版本控制忽略规则
#
# 原则：仓库 = 「源码 + 文档 + 运行时必需数据」。
#       可重跑的中间产物、本地备份、验收截图、依赖目录一律不入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 缓存 / 编译 / 日志 ----------
.cache/
__pycache__/
*.pyc
*.log
npm-debug.log*

# ---------- 本地备份（带时间戳的 *copy of record）----------
_bak/
_archived/
*.bak
*.bak-*
*.bak_*
public/*.bak-v*
data/*.bak-*

# ---------- 抓取中间产物（可由 tools/ 里的脚本重跑，运行时不需要）----------
#   data/_mod-raw.json  (~18MB)  fetch-mods.js --offline 用
#   data/_gcm-raw.json  (~0.8MB) 修改器采集原始缓存
data/_*-raw.json
data/*.progress.json
#   data/_mm-raw/     (~0.4MB)  MobileModels 的原始 brands/*.md 缓存
#   data/_kalvo-raw/  (~0.1MB)  kalvo 设备页 HTML 样本（解析器回归用，缺了不影响）
data/_mm-raw/
data/_kalvo-raw/

# ---------- 本地验收产物（浏览器实拍截图等，体积大）----------
_preview/

# ---------- 临时工作目录（线上页面抓取比对 / 测试日志，可重跑）----------
_online/
_test-out/

# ---------- AI 工作台本地目录（记忆 / 产物 / 技能）----------
.workbuddy/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---------- 临时探针（一次性调试用，非项目组成）----------
tools/_*
