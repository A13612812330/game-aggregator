# ============================================================
# GameHub (game-aggregator) — 版本控制忽略规则
#
# 原则：仓库 = 「源码 + 文档 + 运行时必需数据」。
#       可重跑的中间产物、本地备份、验收截图、依赖目录一律不入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/

# ---------- 缓存 / 编译 / 日志 ----------
.cache/
__pycache__/
*.pyc
*.log
npm-debug.log*

# ---------- 本地备份（带时间戳的 *copy of record）----------
_bak/
_archived/
*.bak
*.bak-*
*.bak_*
public/*.bak-v*
data/*.bak-*

# ---------- 抓取中间产物（可由 tools/ 里的脚本重跑，运行时不需要）----------
#   data/_mod-raw.json  (~18MB)  fetch-mods.js --offline 用
#   data/_gcm-raw.json  (~0.8MB) 修改器采集原始缓存
data/_*-raw.json
#   v10.57：本体下载通道逐款实测结果（tools/_probe-core-dl.js 产出，可重跑、含源站直链）
#   ⚠️ 单独点名而不是并进上面那条：它的名字不含 `-raw`，漏掉就会连带**直链**一起入库。
data/_core-dl-probe.json
data/*.progress.json
#   data/_mm-raw/     (~0.4MB)  MobileModels 的原始 brands/*.md 缓存
#   data/_kalvo-raw/  (~0.1MB)  kalvo 设备页 HTML 样本（解析器回归用，缺了不影响）
data/_mm-raw/
data/_kalvo-raw/

# ---------- 本地验收产物（浏览器实拍截图等，体积大）----------
_preview/
#   v10.70：参考站侦察（tools/_probe-refs.js）落地的原站 HTML 快照 —— 临时取证物，不入库
_ref/
#   v10.75：探针实拍截图落点。★ 与 `_preview/` **同一类**（都是本地验收产物、体积大、
#   可重跑）—— 本轮探针写成了 `.ref/`，属于命名不一致，**下一轮请统一用 `_preview/`**；
#   这里先把它忽略掉，避免 8.5MB 截图被顺手提交进仓库。
.ref/

# ---------- 临时工作目录（线上页面抓取比对 / 测试日志，可重跑）----------
_online/
_test-out/
#   ★ v10.109：**项目内临时目录**（用户口径「后续的 Temp 不要在 C 盘」）。
#   server.js 启动时把本进程树的 TEMP/TMP/TMPDIR 全部指到这里
#   （见 data/runtime-tmp.js），spawn 出来的 aria2 / 7z / 刷新脚本一并跟着走。
#   ⇒ 它里面装的是任何临时垃圾，绝不入库；但也**不要手工删目录本身**，
#     长驻进程启动时就 mkdir 过它，删掉只会让下一次写临时文件报 ENOENT。
_tmp/
#   v10.71 新增：桌面拖放工具（解压助手-拖放.cmd / .vbs）产出的本地解压报告。
#   每跑一次多一份、内含用户的本地绝对路径（可能含隐私），一律不入库。
_extract-out/
#   ★ v10.67 新增：本地**判版与改前改后对照**的落点（线上 md5 快照、重建前的旧产物副本）。
#   为什么必须留一份「改前」：`data/_core-dl-probe.json` 是 .gitignore 的（第 33 行），
#   探针脚本又是**增量合并**写入 ⇒ 重建名单页后**没有第二份可比对**了。
#   本轮就是靠这里的 `_roster-*.BEFORE.json` 逐行核对了「旧的 168 条本体实测结果没变」。
#   纯排查产物、可随时重建 ⇒ 不入库。
_verify/
#   预热长跑进度（build-steam-req.js 每批刷新，只给「从外面看跑到哪了」用）
/_prewarm-progress.json

# ---------- AI 工作台本地目录（记忆 / 产物 / 技能）----------
.workbuddy/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---------- 临时探针（一次性调试用，非项目组成）----------
tools/_*
#   ★ 根级 `_*` 有**已入库**的历史产物（`_preview-cards.html/.js`），所以不能一刀切忽略 `_*`，
#     只能点名。v10.22 漏过两个（`_dlcheck.js` / `_syntax-index.js` 一度出现在未跟踪列表里）。
/_dlcheck.js
/_syntax-*.js
/_probe*.js
#   v10.28 又漏过两个（手工拆内联脚本做语法检查留下的 `_check.js` / `_extracted.js`）。
#   ⇒ 已正式化为 `tools/check-inline-syntax.js`，产物固定落 `_test-out/`（已忽略），
#     根级**不该再出现**临时 JS；下面点名兜住，防止旧习惯复发。
/_check.js
/_extracted.js
#   v10.33 起：反证工具 `tools/_counterproof-v*.js` 的**工作副本目录**。
#   它把被守护的文件复制到根级 `_cf<版本>/` 再打坏跑测试（每次重跑整体重建，不是源码）。
#   ⚠️ 用通配 `/_cf*/` 而不是点名 `/_cf133/` —— v10.34 新增 `_cf134/` 时，
#      点名写法会让新目录**立刻**出现在未跟踪列表里（每个版本都要记得加，早晚忘）。
#   ⇒ 仍不能一刀切 `_*`（根级有已入库的 `_preview-cards.*`），所以只覆盖这一个前缀。
/_cf*/
#   v10.46 起：排查用探针的工作目录（A/B 对比、口径反推、逐条差异、页面字节测量等）。
#   ⚠️ 同 `/_cf*/` 的理由：用通配 `/_probe*/` 而不是点名 `/_probe2/` ——
#      点名写法会让下一个探针目录**立刻**出现"未跟踪"，早晚忘（v10.22 / v10.28 各栽一次）。
#   实测 `_probe2/` = 11 MB / 61 个文件，纯排查产物，重跑的脚本都在里面、可随时重建。
/_probe*/

#   v10.85：管理页豁免旁路文件（用户手写/管理页写入的个人豁免，不入库——
#      与 cold-hide.js 注释口径一致：库内数据每日同步重建，个人豁免属于本地状态）
data/hide-overrides.json
data/admin-token.json
data/admin-log.jsonl
#   v10.91：管理员账号（只存 scrypt 派生值 + salt，但仍是凭据文件 ⇒ 不入库）
data/admin-account.json

#   v10.103：磁力下载配置（下载目录 / 限速 / 并发 / 做种时长）。
#   ★ 下载目录是本机绝对路径（可能含用户名）⇒ 属于本机状态，不入库。
#     代码里的 MAGNET_CFG_DEF 才是默认值真源，文件只是覆盖层。
data/magnet-config.json

#   v10.93：云下载任务与正文（用户下到一半的文件 + aria2 会话 + 种子缓存）。
#   ★ 必须忽略：单任务上限 30 GB，一个任务就能把仓库撑爆；
#     而且里面是**用户的下载内容**，不是项目数据。
#   ★ 整目录忽略而不是逐个文件：aria2 会在这里放 .aria2 控制文件、.torrent、dht.dat，
#     名字都不固定，逐个点名必然漏（v10.22 / v10.28 的教训）。
data/downloads/

#   v10.93：自带的 aria2 二进制（可选，用于「打包 EXE 分发」形态）。
#   服务端版走 apt 安装，不放二进制进仓库；桌面版由构建脚本单独分发。
vendor/aria2/

#   ★ v10.101：Komo Convert 安装包（「点磁力 → 本机工具」的兜底下载出口）。
#   97 MB 的二进制不进版本库：它是**发布产物**，不是源码；进仓库会让每次 clone 多背 97 MB，
#   而且和 docs/reports 那批快照一样属于「可再生资源」。部署时由载荷目录单独携带。
#   ⚠️ 换版本时记得同时改首页里的 KC_SETUP 常量，否则指向一个已经不存在的文件名。
public/dl/*.zip
public/dl/*.exe
